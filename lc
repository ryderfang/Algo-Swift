#!/bin/bash
# LeetCode CLI
#   ./lc <id> [id ...] - generate solutions + test cases, set Runner to first id
#   ./lc test <id> ... - only generate/update test cases + set Runner
#   ./lc submit <id>   - submit the solution for <id> to LeetCode
#   ./lc cookie [ck]   - show session status, or save a browser cookie
DIR="$(dirname "$0")/Scripts"

if [ "$1" = "cookie" ]; then
    shift
    python3 "$DIR/lc_cookie.py" "$@"
elif [ "$1" = "submit" ]; then
    shift
    python3 "$DIR/submit_leetcode.py" "$@"
elif [ "$1" = "test" ]; then
    shift
    python3 "$DIR/gen_tests.py" "$@"
else
    python3 "$DIR/gen_leetcode.py" "$@" && python3 "$DIR/gen_tests.py" "$@"
fi
